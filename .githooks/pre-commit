#!/bin/bash
# Pre-commit hook to prevent forbidden term exposure

set -e

echo "🔍 Running security pre-commit checks..."

# Define forbidden terms that should not be committed
FORBIDDEN_TERMS="AtomicEventBuffer|AtomicBitPackedState|LockFreeCounter|AdaptiveThreshold|PredictiveAnalyzer|SmartCache|kindly-guard-core|kindly_guard_core|EventBuffer|StateManager|ThresholdManager|Analyzer|Cache|Counter|CompactedEventStore|OptimizedRateLimiter|CorrelationIndex|SnapshotEngine|ArchivalSystem|zero-copy|zero_copy|zerocopy|ZeroCopy|EventCompaction|MemoryMapped|memory-mapped|mmap|SIMD|lock-free|lockfree"

# Check for forbidden terms in staged files
echo "Checking for forbidden terms..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(rs|toml|md|yml|yaml|json|sh)$' || true)

if [ -n "$STAGED_FILES" ]; then
    # Check if pre-commit hook itself is being modified
    if echo "$STAGED_FILES" | grep -q "pre-commit"; then
        echo "❌ ERROR: Attempting to modify pre-commit hook"
        echo "   Pre-commit hook modifications require explicit approval"
        echo "   If you need to modify the hook, use: git commit --no-verify"
        exit 1
    fi
    
    for file in $STAGED_FILES; do
        # Skip checking files that are in .gitignore
        if git check-ignore -q "$file"; then
            continue
        fi
        
        # Check for forbidden terms
        if grep -E "$FORBIDDEN_TERMS" "$file" 2>/dev/null; then
            echo "❌ ERROR: Proprietary terms detected in $file"
            echo "   Please remove references to: $FORBIDDEN_TERMS"
            exit 1
        fi
        
        # Check for direct imports from private crate in Rust files
        if [[ "$file" == *.rs ]] && grep -E "use kindly_guard_core::" "$file" 2>/dev/null; then
            echo "❌ ERROR: Direct import from private crate detected in $file"
            echo "   Use trait abstractions instead of direct imports"
            exit 1
        fi
        
        # Check for direct enhanced module imports
        if [[ "$file" == *.rs ]] && grep -E "use (crate::)?[a-z_]+::enhanced::" "$file" 2>/dev/null; then
            echo "❌ ERROR: Direct import from enhanced module detected in $file"
            echo "   Use factory pattern with trait abstractions instead"
            exit 1
        fi
        
        # Check for advanced algorithm patterns
        ADVANCED_PATTERNS="zero[_-]?copy|lock[_-]?free|kernel[_-]?bypass|rdma|simd|vectoriz|quantum[_-]?resistant"
        if grep -iE "$ADVANCED_PATTERNS" "$file" 2>/dev/null | grep -v "// ALLOWED:" | grep -v "# ALLOWED:"; then
            echo "⚠️  WARNING: Advanced algorithm reference detected in $file"
            echo "   Consider if this reveals proprietary implementation details"
            echo "   Add '// ALLOWED: <reason>' comment to suppress this warning"
        fi
    done
fi

# Check for unwrap() in production Rust code
echo "Checking for unwrap() usage..."
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' | grep -v test | grep -v example || true)

if [ -n "$RUST_FILES" ]; then
    UNWRAP_COUNT=0
    for file in $RUST_FILES; do
        if grep -q "\.unwrap()" "$file" 2>/dev/null; then
            echo "⚠️  WARNING: unwrap() detected in $file"
            UNWRAP_COUNT=$((UNWRAP_COUNT + 1))
        fi
    done
    
    if [ $UNWRAP_COUNT -gt 0 ]; then
        echo "⚠️  Found $UNWRAP_COUNT files with unwrap() calls"
        echo "   Consider using proper error handling with Result<T, E>"
    fi
fi

echo "✅ Security pre-commit checks passed!"
exit 0